<%# PÁGINA DE LOGIN
    O formulário envia POST /login e o SERVIDOR confere a senha. O servidor passa:
      erro    -> '' ou "E-mail ou senha incorretos."
      email   -> o e-mail digitado (a senha nunca volta)
      lembrar -> se a caixinha estava marcada
      voltar  -> para onde ir depois de entrar ('' = Minha conta) -%>
<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/head', { titulo: 'Login | CelStore', scripts: ['loja', 'formulario', 'pagina-login'] }) %>
<body data-sem-link-carrinho>
<%- include('partials/navbar', { paginaAtual: 'login' }) %>

<main id="conteudo">
  <h1>Entrar na sua conta</h1>

  <%# novalidate: as mensagens são as nossas (JavaScript na tela e, de novo, o servidor).
      As marcações "required" continuam para os leitores de tela avisarem que o campo é obrigatório. %>
  <form class="formulario" action="/login<%= voltar ? '?voltar=' + encodeURIComponent(voltar) : '' %>" method="post" data-form-login novalidate>
    <%# Resumo dos erros. Tem de ficar sem espaços quando vazio, senão o CSS mostra a caixa. -%>
    <div role="alert" class="mensagem-erro" tabindex="-1"><%= erro %></div>

    <div class="campo">
      <label for="email">E-mail (obrigatório)</label>
      <input type="email" id="email" name="email" value="<%= email %>" required autocomplete="email">
    </div>

    <div class="campo">
      <label for="senha">Senha (obrigatório)</label>
      <input type="password" id="senha" name="senha" required autocomplete="current-password" aria-describedby="dica-senha">
      <p id="dica-senha" class="dica-campo">Use a senha que você criou no cadastro.</p>
    </div>

    <div class="campo lembrete">
      <input type="checkbox" id="lembrar" name="lembrar"<%= lembrar ? ' checked' : '' %>>
      <label for="lembrar">Lembrar de mim</label>
    </div>

    <button type="submit" class="btn btn-bloco btn-grande" data-botao-enviar>Entrar</button>
  </form>

  <ul class="links-auxiliares">
    <li><a href="#">Esqueci minha senha</a></li>
    <li><a href="/cadastro">Ainda não tem conta? Cadastre-se</a></li>
  </ul>
</main>

<%- include('partials/footer', { paginaAtual: 'login' }) %>
</body>
</html>
