<%# PÁGINA DE CADASTRO. Ainda é a simulação do navegador (public/js/pagina-cadastro.js).
    Na Etapa 3 a conta passa a ser gravada no banco, com a senha protegida (hash). -%>
<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/head', { titulo: 'Cadastro | CelStore', scripts: ['produtos', 'carrinho', 'usuarios', 'loja', 'formulario', 'pagina-cadastro'] }) %>
<body data-sem-link-carrinho>
<%- include('partials/navbar', { paginaAtual: 'cadastro' }) %>

<main id="conteudo">
  <h1>Criar conta</h1>

  <noscript>
    <p class="mensagem-erro">Este formulário precisa de JavaScript para funcionar. Ative o JavaScript no seu navegador e recarregue a página.</p>
  </noscript>

  <!-- novalidate: os erros aparecem por JavaScript (js/pagina-cadastro.js), com mensagens próprias.
       As marcações "required" continuam para os leitores de tela avisarem que o campo é obrigatório. -->
  <form class="formulario" data-form-cadastro novalidate>
    <!-- Container para mensagens de erro de validação exibidas dinamicamente -->
    <div role="alert" class="mensagem-erro"></div>

    <fieldset>
      <legend>Dados pessoais</legend>

      <div class="campo">
        <label for="nome">Nome completo (obrigatório)</label>
        <input type="text" id="nome" name="nome" required autocomplete="name">
      </div>

      <div class="campo">
        <label for="cpf">CPF (obrigatório)</label>
        <input type="text" id="cpf" name="cpf" required autocomplete="off" aria-describedby="dica-cpf">
        <p id="dica-cpf" class="dica-campo">Formato: 000.000.000-00</p>
      </div>

      <div class="campo">
        <label for="nascimento">Data de nascimento (obrigatório)</label>
        <input type="date" id="nascimento" name="nascimento" required autocomplete="bday">
      </div>

      <div class="campo">
        <label for="telefone">Telefone (obrigatório)</label>
        <input type="tel" id="telefone" name="telefone" required autocomplete="tel" aria-describedby="dica-telefone">
        <p id="dica-telefone" class="dica-campo">Formato: (00) 00000-0000</p>
      </div>
    </fieldset>

    <fieldset>
      <legend>Dados de acesso</legend>

      <div class="campo">
        <label for="email">E-mail (obrigatório)</label>
        <input type="email" id="email" name="email" required autocomplete="email">
      </div>

      <div class="campo">
        <label for="senha">Senha (obrigatório)</label>
        <input type="password" id="senha" name="senha" required autocomplete="new-password" aria-describedby="dica-senha">
        <p id="dica-senha" class="dica-campo">Mínimo de 8 caracteres, incluindo letras e números.</p>
      </div>

      <div class="campo">
        <label for="confirmar-senha">Confirmar senha (obrigatório)</label>
        <input type="password" id="confirmar-senha" name="confirmar-senha" required autocomplete="new-password">
      </div>
    </fieldset>

    <fieldset class="preferencias">
      <legend>Preferências</legend>

      <div class="campo">
        <input type="checkbox" id="ofertas" name="ofertas">
        <label for="ofertas">Quero receber ofertas por e-mail</label>
      </div>

      <div class="campo">
        <input type="checkbox" id="termos" name="termos" required>
        <label for="termos">Li e aceito os <a href="#">termos de uso</a> (obrigatório)</label>
      </div>
    </fieldset>

    <button type="submit" class="btn btn-bloco btn-grande" data-botao-enviar>Criar conta</button>
  </form>

  <!-- Estado de sucesso: aparece no lugar do formulário depois de criar a conta -->
  <div class="coluna-estreita">
    <section class="confirmacao" data-cadastro-sucesso hidden aria-labelledby="titulo-conta-criada">
      <span class="icone-sucesso" aria-hidden="true">✓</span>
      <h2 id="titulo-conta-criada" tabindex="-1" data-cadastro-titulo></h2>
      <p>Agora você já pode entrar com o e-mail <strong data-cadastro-email></strong>.</p>
      <p class="acoes-finais">
        <a href="/login" class="btn">Entrar na conta</a>
      </p>
    </section>
  </div>

  <ul class="links-auxiliares">
    <li><a href="/login">Já tem conta? Entrar</a></li>
  </ul>
</main>

<%- include('partials/footer', { paginaAtual: 'cadastro' }) %>
</body>
</html>
