<%# PÁGINA DO CARRINHO (GET /carrinho). Tudo é calculado no SERVIDOR com os preços do banco.
    O servidor passa:
      resumo            -> { linhas: [{ produto, quantidade, subtotal }], unidades, total }
      QUANTIDADE_MAXIMA -> limite de unidades por produto (10)
    Cada ação (atualizar, remover) é um formulário POST: funciona até sem JavaScript. -%>
<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/head', { titulo: 'Carrinho | CelStore', scripts: ['loja'] }) %>
<body data-sem-link-carrinho>
<%- include('partials/navbar', { paginaAtual: 'carrinho' }) %>

<main id="conteudo">
  <h1>Seu carrinho</h1>

  <nav class="etapas" aria-label="Etapas da compra">
    <ol>
      <li aria-current="step">Carrinho</li>
      <li>Entrega e pagamento</li>
      <li>Confirmação</li>
    </ol>
  </nav>

<% if (resumo.linhas.length > 0) { -%>
  <div class="layout-compra">
    <section aria-labelledby="titulo-itens">
      <h2 id="titulo-itens" class="titulo-secao">Itens (<%= resumo.unidades %>)</h2>

      <ul class="lista-carrinho">
<% resumo.linhas.forEach(function (linha) { const p = linha.produto; -%>
        <li class="item-carrinho">
          <img src="<%= p.imagem %>" alt="<%= p.alt %>" width="<%= p.largura %>" height="<%= p.altura %>">
          <div class="item-info">
            <h3><%= p.nome %></h3>
            <p class="item-preco"><%= formatarPreco(p.preco) %> cada</p>
            <div class="item-acoes">
              <%# Muda a quantidade: o servidor confere e corrige (mínimo 1, máximo 10). -%>
              <form action="/carrinho/atualizar" method="post" class="item-acoes">
                <input type="hidden" name="slug" value="<%= p.slug %>">
                <div class="campo campo-quantidade">
                  <label for="qtd-<%= p.slug %>">Quantidade<span class="sr-only"> de <%= p.nome %></span></label>
                  <input type="number" id="qtd-<%= p.slug %>" name="quantidade" value="<%= linha.quantidade %>" min="1" max="<%= QUANTIDADE_MAXIMA %>">
                </div>
                <button type="submit" class="btn btn-secundario">Atualizar<span class="sr-only"> quantidade de <%= p.nome %></span></button>
              </form>
              <form action="/carrinho/remover" method="post">
                <input type="hidden" name="slug" value="<%= p.slug %>">
                <button type="submit" class="btn btn-link">Remover<span class="sr-only"> <%= p.nome %> do carrinho</span></button>
              </form>
            </div>
          </div>
          <p class="item-subtotal"><span class="sr-only">Subtotal: </span><%= formatarPreco(linha.subtotal) %></p>
        </li>
<% }) -%>
      </ul>
    </section>

    <section class="resumo" aria-labelledby="titulo-resumo">
      <h2 id="titulo-resumo" class="titulo-secao">Resumo do pedido</h2>

      <dl class="resumo-valores">
        <div>
          <dt>Subtotal (<%= resumo.unidades === 1 ? '1 item' : resumo.unidades + ' itens' %>)</dt>
          <dd><%= formatarPreco(resumo.total) %></dd>
        </div>
        <div>
          <dt>Frete</dt>
          <dd>Grátis</dd>
        </div>
        <div class="resumo-total">
          <dt>Total</dt>
          <dd><%= formatarPreco(resumo.total) %></dd>
        </div>
      </dl>

      <p class="resumo-parcelas">Ou em até 12x de <%= formatarPreco(resumo.total / 12) %> sem juros no cartão de crédito.</p>

      <a href="/checkout" class="btn btn-bloco">Finalizar compra</a>
      <a href="/" class="btn btn-secundario btn-bloco">Continuar comprando</a>
    </section>
  </div>
<% } else { -%>
  <%# Estado VAZIO -%>
  <section class="estado-vazio" aria-labelledby="titulo-vazio">
    <span class="icone-vazio" aria-hidden="true">🛒</span>
    <h2 id="titulo-vazio">Seu carrinho está vazio</h2>
    <p>Que tal dar uma olhada nos celulares da loja?</p>
    <a href="/" class="btn">Ver celulares</a>
  </section>
<% } -%>
</main>

<%- include('partials/footer', { paginaAtual: 'carrinho' }) %>
</body>
</html>
