<%# PÁGINA DO CARRINHO. Os itens ainda são desenhados no navegador por public/js/pagina-carrinho.js,
    a partir do localStorage. Na Etapa 4 o carrinho passa para o servidor. -%>
<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/head', { titulo: 'Carrinho | CelStore', scripts: ['produtos', 'carrinho', 'usuarios', 'loja', 'pagina-carrinho'] }) %>
<body data-sem-link-carrinho>
<%- include('partials/navbar', { paginaAtual: 'carrinho' }) %>

<main id="conteudo">
  <h1>Seu carrinho</h1>

  <nav class="etapas" aria-label="Etapas da compra">
    <ol>
      <li aria-current="step">Carrinho</li>
      <li>Entrega e pagamento</li>
      <li>Confirmação</li>
    </ol>
  </nav>

  <noscript>
    <p class="mensagem-erro">O carrinho precisa de JavaScript para funcionar. Ative o JavaScript no seu navegador e recarregue a página.</p>
  </noscript>

  <!-- Os itens e os valores são desenhados por js/pagina-carrinho.js a partir do que está no localStorage.
       Este bloco começa escondido (hidden) e o JS mostra ele quando existem itens. -->
  <div class="layout-compra" data-carrinho-conteudo hidden>
    <section aria-labelledby="titulo-itens">
      <h2 id="titulo-itens" class="titulo-secao" tabindex="-1">Itens (<span data-titulo-qtd>0</span>)</h2>

      <ul class="lista-carrinho" data-lista-carrinho></ul>
    </section>

    <section class="resumo" aria-labelledby="titulo-resumo">
      <h2 id="titulo-resumo" class="titulo-secao">Resumo do pedido</h2>

      <dl class="resumo-valores">
        <div>
          <dt data-resumo-rotulo>Subtotal</dt>
          <dd data-resumo-subtotal>R$ 0</dd>
        </div>
        <div>
          <dt>Frete</dt>
          <dd>Grátis</dd>
        </div>
        <div class="resumo-total">
          <dt>Total</dt>
          <!-- aria-live: o leitor de tela avisa o novo total quando ele muda -->
          <dd data-resumo-total aria-live="polite">R$ 0</dd>
        </div>
      </dl>

      <p class="resumo-parcelas" data-resumo-parcelas></p>

      <a href="/checkout" class="btn btn-bloco">Finalizar compra</a>
      <a href="/" class="btn btn-secundario btn-bloco">Continuar comprando</a>
    </section>
  </div>

  <!-- Estado "carrinho vazio": aparece quando não há nenhum item -->
  <section class="estado-vazio" data-carrinho-vazio hidden aria-labelledby="titulo-vazio">
    <span class="icone-vazio" aria-hidden="true">🛒</span>
    <h2 id="titulo-vazio" tabindex="-1">Seu carrinho está vazio</h2>
    <p>Que tal dar uma olhada nos celulares da loja?</p>
    <a href="/" class="btn">Ver celulares</a>
  </section>
</main>

<%- include('partials/footer', { paginaAtual: 'carrinho' }) %>
</body>
</html>
