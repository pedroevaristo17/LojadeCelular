<%# PÁGINA DO PRODUTO: uma página só para todos os celulares.
    O servidor (rota GET /produto/:slug no index.js) passa:
      produto  -> o celular do endereço, ou null se o endereço não existe (aí a página mostra o estado de erro, com status 404)
      garantia -> texto da garantia ("12 meses")
    Antes, o JavaScript do navegador lia o endereço e preenchia a página. Agora ela já chega pronta do servidor. -%>
<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/head', {
    titulo: produto ? produto.nome + ' | CelStore' : 'Produto não encontrado | CelStore',
    scripts: ['loja']
}) %>
<body>
<%- include('partials/navbar', { paginaAtual: 'produto' }) %>

<main id="conteudo">
<% if (produto) { -%>
  <nav class="migalhas" aria-label="Você está aqui">
    <ol>
      <li><a href="/">Início</a></li>
      <li aria-current="page"><%= produto.nome %></li>
    </ol>
  </nav>

  <article class="detalhe">
    <div class="detalhe-imagem">
      <img src="<%= produto.imagem %>" alt="<%= produto.alt %>" width="<%= produto.largura %>" height="<%= produto.altura %>">
    </div>

    <div class="detalhe-info">
      <h1><%= produto.nome %></h1>

      <p class="preco">De <del><%= formatarPreco(produto.precoAntigo) %></del> por <ins><%= formatarPreco(produto.preco) %></ins></p>
      <p class="parcelamento">Em até 12x de <%= formatarPreco(produto.preco / 12) %> sem juros no cartão de crédito.</p>

      <%# Envia para o servidor só QUAL produto e QUANTAS unidades. O preço o servidor busca no banco. -%>
      <form class="form-compra" action="/carrinho/adicionar" method="post">
        <input type="hidden" name="slug" value="<%= produto.slug %>">
        <input type="hidden" name="voltar" value="<%= urlAtual %>">
        <div class="campo campo-quantidade">
          <label for="quantidade">Quantidade</label>
          <input type="number" id="quantidade" name="quantidade" value="1" min="1" max="10">
        </div>
        <button type="submit" class="btn">Adicionar ao carrinho</button>
      </form>

      <ul class="beneficios">
        <li>Frete grátis para compras acima de R$ 299</li>
        <li><%= garantia %> de garantia</li>
      </ul>
    </div>
  </article>

  <section class="especificacoes-detalhe" aria-labelledby="titulo-specs">
    <h2 id="titulo-specs" class="titulo-secao">Especificações</h2>
    <table class="tabela-specs">
      <tbody>
<% produto.ficha.concat([['Garantia', garantia]]).forEach(function (linha) { -%>
        <tr>
          <th scope="row"><%= linha[0] %></th>
          <td><%= linha[1] %></td>
        </tr>
<% }) -%>
      </tbody>
    </table>
  </section>
<% } else { -%>
  <%# Estado de erro: o endereço não corresponde a nenhum produto -%>
  <section class="estado-vazio" aria-labelledby="titulo-erro">
    <span class="icone-vazio" aria-hidden="true">🔍</span>
    <h1 id="titulo-erro">Produto não encontrado</h1>
    <p>Não encontramos o celular que você procura. Ele pode ter saído da loja ou o endereço pode estar errado.</p>
    <a href="/" class="btn">Ver todos os celulares</a>
  </section>
<% } -%>
</main>

<%- include('partials/footer') %>
</body>
</html>
