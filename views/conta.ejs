<%# MINHA CONTA (só para quem está logado: a rota usa requireAuth).
    "user" vem de res.locals: { id, nome, email }, lido da sessão no servidor.
    pedidos -> as compras DESTA pessoa (filtradas por userId no servidor), da mais nova para a mais antiga. -%>
<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/head', { titulo: 'Minha conta | CelStore', scripts: ['loja'] }) %>
<body data-sem-link-carrinho>
<%- include('partials/navbar', { paginaAtual: 'conta' }) %>

<main id="conteudo">
  <h1>Minha conta</h1>

  <section class="resumo" aria-labelledby="titulo-dados">
    <h2 id="titulo-dados" class="titulo-secao">Seus dados</h2>

    <dl class="dados-pedido">
      <dt>Nome</dt>
      <dd><%= user.nome %></dd>
      <dt>E-mail</dt>
      <dd><%= user.email %></dd>
    </dl>

    <%# Sair muda algo no servidor, por isso é um formulário POST. %>
    <form action="/sair" method="post" class="acoes-finais">
      <button type="submit" class="btn btn-secundario">Sair</button>
    </form>
  </section>

  <section class="minhas-compras" aria-labelledby="titulo-compras">
    <h2 id="titulo-compras" class="titulo-secao">Minhas compras</h2>

<% if (pedidos.length === 0) { -%>
    <%# Estado VAZIO -%>
    <div class="estado-vazio">
      <span class="icone-vazio" aria-hidden="true">📦</span>
      <h3>Você ainda não fez nenhuma compra</h3>
      <p>Quando você finalizar um pedido, ele aparece aqui.</p>
      <a href="/" class="btn">Ver celulares</a>
    </div>
<% } else { -%>
    <%# <details> abre e fecha sem JavaScript, e funciona com teclado (Enter ou Espaço no resumo). -%>
<% pedidos.forEach(function (pedido) { -%>
    <details class="pedido-conta">
      <summary>
        <strong><%= pedido.numero %></strong>
        <span><%= formatarData(pedido.createdAt) %></span>
        <span><%= formatarPreco(pedido.total) %></span>
      </summary>
      <ul class="resumo-itens">
<% pedido.itens.forEach(function (item) { -%>
        <li><span><%= item.nome %> (<%= item.quantidade %> un.)</span> <span><%= formatarPreco(item.subtotal) %></span></li>
<% }) -%>
      </ul>
      <dl class="dados-pedido">
        <dt>Forma de pagamento</dt>
        <dd><%= PAGAMENTOS[pedido.pagamento] %></dd>
      </dl>
      <p><a href="/pedido/<%= pedido.numero %>">Ver detalhes<span class="sr-only"> do pedido <%= pedido.numero %></span></a></p>
    </details>
<% }) -%>
<% } -%>
  </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
